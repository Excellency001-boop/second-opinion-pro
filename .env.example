# Copy to .env.local for dev, and set the same in Vercel for prod.
# Everything has a sane default, so the app runs with NONE of these set (demo mode).

# --- Always-on storage (production). Free tier at upstash.com. ---
# Without these, the app uses a local file store (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- The heartbeat secret. Must match the GitHub Action / Vercel Cron secret. ---
CRON_SECRET=change-me-to-a-long-random-string

# --- X Layer ---
XLAYER_RPC_URL=https://rpc.xlayer.tech
OKB_PRICE_USD=44

# --- One-time ERC-8004 identity registry on X Layer (set after registering) ---
ERC8004_IDENTITY_REGISTRY=

# --- Execution mode ---
# false = faithful simulation (default, honest, every step flagged as sim).
# true  = real on-chain execution + real x402 settlement (needs a funded agent wallet).
LIVE_EXECUTION=false
# true = the desk may auto-execute within caps without waiting for approval.
AUTO_EXECUTE=false

# --- Guardrails (safety rails for the autonomous agent) ---
MAX_AGENT_FEES_PER_RUN_USDC=5
MAX_TRADE_NOTIONAL_USDC=50000
